# ==========================================
# CityPulse Command Center - Environment Config
# ==========================================

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_GOOGLE_MAPS_API_KEY=
VITE_MAPTILER_API_KEY=your_maptiler_key_here

# Backend Services (Never expose secrets to client)
TOMTOM_API_KEY=
OPENAI_API_KEY=
OPENAQ_API_KEY=
MAPBOX_ACCESS_TOKEN=
CESIUM_ION_TOKEN=
MAPTILER_API_KEY=

# Geographic Defaults (Default city: Jaipur, India - but supports arbitrary cities)
DEFAULT_CITY=Jaipur
DEFAULT_LATITUDE=26.9124
DEFAULT_LONGITUDE=75.7873
DEFAULT_TIMEZONE=Asia/Kolkata

# Data Mode: "LIVE", "DEMO", or "MIXED"
DATA_MODE=MIXED
